{
  "compatibility_date": "2026-01-27",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "astro-medusa-starter",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "store.tellmey.fyi/*",
      "custom_domain": false,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
