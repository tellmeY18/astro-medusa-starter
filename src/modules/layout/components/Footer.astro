---
interface Props {
  countryCode: string;
}

const { countryCode } = Astro.props;
const currentYear = new Date().getFullYear();

const shopLinks = [
  { href: `/${countryCode}`, label: "Home" },
  { href: `/${countryCode}/store`, label: "All products" },
  { href: `/${countryCode}/cart`, label: "Cart" },
  { href: `/${countryCode}/checkout`, label: "Checkout" },
];

const companyLinks = [
  { href: `/${countryCode}/privacy`, label: "Privacy" },
  { href: `/${countryCode}/terms`, label: "Terms" },
];
---

<footer class="border-t border-bark/15 bg-sand">
  <div class="px-6 py-12 sm:px-8 md:px-12 lg:px-16">
    <div
      class="grid gap-10 border-b border-bark/15 pb-10 md:grid-cols-2 xl:grid-cols-[1.2fr_0.8fr_0.8fr_1fr]"
    >
      <section class="max-w-md">
        <p
          class="text-xs font-semibold uppercase tracking-[0.28em] text-bark/60"
        >
          My Store
        </p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-bark">
          A storefront that feels ready to ship.
        </h2>
        <p class="mt-4 text-sm leading-6 text-bark/70">
          Built for fast browsing, clean checkout, and a polished shopping flow
          from first click to confirmed order.
        </p>
      </section>

      <nav aria-label="Footer shop navigation">
        <p class="text-sm font-semibold text-bark">Shop</p>
        <ul class="mt-4 space-y-3 text-sm text-bark/70">
          {
            shopLinks.map((link) => (
              <li>
                <a class="transition hover:text-bark" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Footer company navigation">
        <p class="text-sm font-semibold text-bark">Company</p>
        <ul class="mt-4 space-y-3 text-sm text-bark/70">
          {
            companyLinks.map((link) => (
              <li>
                <a class="transition hover:text-bark" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section>
        <p class="text-sm font-semibold text-bark">Customer Care</p>
        <div class="mt-4 space-y-4 text-sm text-bark/70">
          <p>
            Browse the catalog, test the cart, and explore the full purchase
            flow end to end.
          </p>
          <a
            class="inline-flex rounded-full bg-bark px-5 py-3 text-sm font-medium text-cream transition hover:bg-bark/85"
            href={`/${countryCode}/store`}
          >
            Start shopping
          </a>
        </div>
      </section>
    </div>

    <p class="text-sm text-bark/60 pt-6">
      &copy; {currentYear} My Store.
    </p>
  </div>
</footer>
