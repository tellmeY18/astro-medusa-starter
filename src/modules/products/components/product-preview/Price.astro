---
interface Props {
  priceType: string;
  originalPrice: string;
  calculatedPrice: string;
}

const { priceType, originalPrice, calculatedPrice } = Astro.props;
---

<>
  {priceType === "sale" && (
    <p data-testid="original-price">
      <s class="text-bark/60 mr-2">{originalPrice}</s>
    </p>
  )}
  <p data-testid="price" class="font-medium">
    {calculatedPrice}
  </p>
</>