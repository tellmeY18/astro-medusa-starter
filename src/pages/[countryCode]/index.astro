</section>

</div><!-- end .pinoki-page -->

<!-- AUTOMATIC SLIDESHOW SCRIPT -->
<script is:inline>
  const slideshows = {
    kumbil: { currentIndex: 0, timer: null },
    acacia: { currentIndex: 0, timer: null }
  };

  function toggleMenu() {
    var nav = document.querySelector('header nav');
    var btn = document.querySelector('.hamburger');
    if (!nav || !btn) return;
    var open = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function changeProductView(productId, imgSrc, descText, btnElement, isManual = false) {
    const mainImg = document.getElementById(productId + '-main');
    const descEl = document.getElementById(productId + '-desc');

    if (mainImg) {
      var preload = new Image();
      preload.src = imgSrc;
      preload.onload = function() {
        mainImg.style.opacity = '0';
        setTimeout(() => {
          mainImg.src = imgSrc;
          mainImg.style.opacity = '1';
        }, 120);
      };
    }

    if (descEl) {
      descEl.style.opacity = '0';
      setTimeout(() => {
        descEl.textContent = descText;
        descEl.style.opacity = '1';
      }, 150);
    }

    const thumbsContainer = btnElement.parentElement;
    const buttons = Array.from(thumbsContainer.querySelectorAll('.thumb-btn'));
    buttons.forEach(b => b.classList.remove('active'));
    btnElement.classList.add('active');

    slideshows[productId].currentIndex = buttons.indexOf(btnElement);

    if (isManual) {
      restartAutoSlideshow(productId);
    }
  }

  function startAutoSlideshow(productId) {
    slideshows[productId].timer = setInterval(() => {
      const row = document.getElementById(productId + '-row');
      if (!row) return;
      const buttons = row.querySelectorAll('.thumb-btn');
      let nextIndex = (slideshows[productId].currentIndex + 1) % buttons.length;
      buttons[nextIndex].click();
    }, 4000);
  }

  function restartAutoSlideshow(productId) {
    clearInterval(slideshows[productId].timer);
    startAutoSlideshow(productId);
  }

  document.addEventListener("DOMContentLoaded", () => {
    startAutoSlideshow('kumbil');
    startAutoSlideshow('acacia');
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap');

