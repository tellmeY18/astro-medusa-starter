---
import Layout from "@layouts/Layout.astro";
import { listProducts } from "@lib/data/products";
import { getRegionParams } from "@lib/params/region-params";
import ProductPreview from "@modules/products/components/product-preview/ProductPreview.astro";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

const products = await listProducts();
---

<Layout
  title="All Products"
  description="Browse our full collection of products."
>
  <div class="px-4 py-6 sm:px-8 md:px-12 lg:px-16">
    <h1 class="text-3xl md:text-4xl font-bold mb-6 md:mb-8">All Products</h1>
    <ul
      aria-label="Products"
      class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 2xl:grid-cols-4 w-full gap-x-4 gap-y-8 md:gap-x-6"
    >
      {
        products.map((product, index) => (
          <li>
            <ProductPreview
              id={product.id}
              variants={product.variants}
              thumbnailUrl={product.thumbnail}
              imageUrl={product.images?.[0]?.url}
              title={product.title}
              priority={index < 4}
            />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
