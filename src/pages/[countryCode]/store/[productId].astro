---
import Layout from "@layouts/Layout.astro";
import { retrieveProduct } from "@lib/data/products";
import { getProductParams } from "@lib/params/product-params";
import { getProductPrice } from "@lib/utils/get-product-price";
import ImageCarouselWrapper from "@modules/products/components/product-details/image-carousel/ImageCarouselWrapper.astro";
import { ProductActions } from "@modules/products/components/product-details/ProductActions";
import ProductAttributes from "@modules/products/components/product-details/ProductAttributes.astro";

export const getStaticPaths = getProductParams;

const { countryCode, productId } = Astro.params;

if (!countryCode || !productId) {
  return Astro.redirect("/not-found");
}

const product = await retrieveProduct(productId);

if (!product) {
  return Astro.redirect("/not-found");
}

const { cheapestPrice } = getProductPrice({
  productVariants: product.variants ?? [],
});
---

<Layout
  title={product.title}
  description={product.description ?? `Shop ${product.title} at the best price.`}
  image={product.images?.[0]?.url}
  type="product"
>
  <div class="grid grid-cols-1 gap-10 lg:gap-20 px-4 py-6 sm:px-8 md:px-12 lg:grid-cols-2 lg:px-16">
    <ImageCarouselWrapper
      images={product.images ?? []}
      alt={product.title ?? "Product image"}
    />

    <div class="flex flex-col gap-10 lg:gap-16">
      <div class="flex flex-col gap-4">
        <h1 class="text-4xl font-bold">{product.title}</h1>
        <p class="text-bark/70">{product.description}</p>
        <p class="text-4xl font-bold">{cheapestPrice?.calculated_price}</p>
      </div>

      <ProductActions
        options={product.options ?? []}
        variants={product.variants ?? []}
        productId={product.id}
        client:visible
      />

      <ProductAttributes
        material={product.material}
        origin_country={product.origin_country}
        weight={product.weight}
        length={product.length}
        width={product.width}
        height={product.height}
      />
    </div>
  </div>
</Layout>
