---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";

export const getStaticPaths = getRegionParams;
---

<Layout
  title="Privacy"
  description="How this storefront handles customer and checkout data."
>
  <section class="mx-auto max-w-3xl px-8 py-12 md:px-12 lg:px-16">
    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-bark/60">
      Privacy
    </p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-bark">
      Privacy-first storefront foundations
    </h1>
    <div class="mt-8 space-y-6 text-base leading-8 text-bark/70">
      <p>
        This storefront keeps customer data handling straightforward.
        Checkout and cart information is only collected when needed to complete
        an order flow.
      </p>
      <p>
        If you adapt this storefront for production, update this page with your own
        business policies, retention periods, and contact details before going
        live.
      </p>
    </div>
  </section>
</Layout>
