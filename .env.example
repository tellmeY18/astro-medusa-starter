# Your Medusa backend, should be updated to where you are hosting your server. Remember to update CORS settings for your server. See – https://docs.medusajs.com/learn/configurations/medusa-config#httpstorecors
PUBLIC_MEDUSA_BACKEND_URL=

# Your publishable key that can be attached to sales channels. See - https://docs.medusajs.com/resources/storefront-development/publishable-api-keys
PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Your preferred default region. ISO-2 lowercase format.
DEFAULT_REGION=

# Stripe publishable key (required for Stripe payment provider). See - https://dashboard.stripe.com/apikeys
PUBLIC_STRIPE_KEY=

# S3 bucket domain for product image optimization (e.g., your-bucket.s3.us-east-1.amazonaws.com). Added to Astro's allowed image domains.
S3_DOMAIN=

# InPost GeoWidget token.
PUBLIC_INPOST_GEOWIDGET_TOKEN=

# Set to true when using InPost sandbox environment.
PUBLIC_INPOST_SANDBOX=

# --- Razorpay -------------------------------------------------------------
# Feature flag for Razorpay checkout. The integration is always deployed; this
# only decides whether customers see the real payment step. Set to "true" and
# redeploy to take live payments.
PUBLIC_RAZORPAY_ENABLED=false

# Publishable key id from https://dashboard.razorpay.com/app/keys — safe for the
# browser. Use the test key while the flag is off.
PUBLIC_RAZORPAY_KEY_ID=

# Server-only secrets. Read from the Cloudflare runtime, never from the build:
#   local dev  -> cp .dev.vars.example .dev.vars (git-ignored), fill with test keys
#   production -> yarn wrangler secret put RAZORPAY_KEY_SECRET
#                  yarn wrangler secret put RAZORPAY_WEBHOOK_SECRET
# The webhook secret comes from the webhook configured in the Razorpay dashboard
# (Settings -> Webhooks -> URL: https://<your-domain>/api/razorpay/webhook).
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
